# ===== Supabase（Phase 1 需要你建项目后填入） =====
# 在 https://supabase.com 新建项目后，于 Project Settings > API 复制以下三项
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== 站点 =====
# 自定义域名（可选，Phase 6 才用；上线先用 Vercel 自动 *.vercel.app 域名）
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ===== 归一桥（只在服务端用，禁止加 NEXT_PUBLIC_） =====
# 桥只绑 127.0.0.1，云端部署访问不到；云端聊天会自动回退 DeepSeek
UNYRA_BRIDGE_URL=http://127.0.0.1:4399
UNYRA_BRIDGE_TOKEN=
# 桥推送资料时用的 HMAC 密钥（X-Unyra-Signature）
UNYRA_INGEST_SECRET=
# /api/library/ingest 收到的资料归属到哪个账号（auth.users.id）
UNYRA_OWNER_USER_ID=

# ===== 模型通道 =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
